--// Load all fish names from ReplicatedStorage.Assets.FishModels
local function loadFishNames()
	local names = {}
	
	-- Check if the folder exists
	if fishModelsFolder then
		for _, fish in ipairs(fishModelsFolder:GetChildren()) do
			-- Only get models
			if fish:IsA("Model") then
				table.insert(names, fish.Name)
			end
		end
	else
		warn("FishModels folder not found in ReplicatedStorage.Assets!")
		-- Fallback to workspace.Game.Fishes if needed
		for _, fish in ipairs(fishesFolder:GetChildren()) do
			if fish:IsA("Model") then
				table.insert(names, fish.Name)
			end
		end
	end
	
	-- Remove duplicates just in case
	local seen = {}
	local unique = {}
	for _, name in ipairs(names) do
		if not seen[name] then
			seen[name] = true
			table.insert(unique, name)
		end
	end
	
	table.sort(unique)
	return unique
end

--// Get all fish names
allFishNames = loadFishNames()

--// Create fish selection buttons
local function createFishButtons()
	-- Clear existing buttons
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local yPos = 0
	for _, fishName in ipairs(allFishNames) do
		local fishBtn = Instance.new("TextButton")
		fishBtn.Size = UDim2.new(1, -10, 0, 20)
		fishBtn.Position = UDim2.new(0, 5, 0, yPos)
		fishBtn.BackgroundColor3 = Color3.fromRGB(25,25,25)
		fishBtn.Text = fishName
		fishBtn.TextColor3 = Color3.fromRGB(200,200,200)
		fishBtn.Font = Enum.Font.Arcade
		fishBtn.TextScaled = true
		fishBtn.BorderSizePixel = 0
		fishBtn.Parent = scrollingFrame
		fishBtn.ZIndex = 21
		Instance.new("UICorner", fishBtn).CornerRadius = UDim.new(0,4)
		
		-- Check if this fish is already selected
		if selectedFishes[fishName] then
			fishBtn.BackgroundColor3 = Color3.fromRGB(255,140,0)
			fishBtn.TextColor3 = Color3.fromRGB(0,0,0)
		end
		
		-- Toggle selection on click
		fishBtn.MouseButton1Click:Connect(function()
			if selectedFishes[fishName] then
				selectedFishes[fishName] = nil
				fishBtn.BackgroundColor3 = Color3.fromRGB(25,25,25)
				fishBtn.TextColor3 = Color3.fromRGB(200,200,200)
			else
				selectedFishes[fishName] = true
				fishBtn.BackgroundColor3 = Color3.fromRGB(255,140,0)
				fishBtn.TextColor3 = Color3.fromRGB(0,0,0)
			end
			
			-- Update dropdown button text
			local count = 0
			for _ in pairs(selectedFishes) do
				count = count + 1
			end
			
			if count == 0 then
				dropdownBtn.Text = "Select Fish ▼"
			elseif count == 1 then
				local name = next(selectedFishes)
				dropdownBtn.Text = name .. " ▼"
			else
				dropdownBtn.Text = count .. " fishes selected ▼"
			end
		end)
		
		yPos = yPos + 22
	end
	
	scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 5)
end

--// Initialize fish buttons
