--// Close dropdown when clicking outside
UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		local pos = UserInputService:GetMouseLocation()
		local absPos = dropdownFrame.AbsolutePosition
		local absSize = dropdownFrame.AbsoluteSize
		
		if dropdownFrame.Visible then
			if pos.X < absPos.X or pos.X > absPos.X + absSize.X or
			   pos.Y < absPos.Y or pos.Y > absPos.Y + absSize.Y then
				local btnPos = dropdownBtn.AbsolutePosition
				local btnSize = dropdownBtn.AbsoluteSize
				if pos.X < btnPos.X or pos.X > btnPos.X + btnSize.X or
				   pos.Y < btnPos.Y or pos.Y > btnPos.Y + btnSize.Y then
					dropdownFrame.Visible = false
				end
			end
		end
	end
end)

-- Function to teleport to surface
local function teleportToSurface()
	statusLabel.Text = "Teleporting to surface..."
	local args = {"Shops"}
	workspace:WaitForChild("Network"):WaitForChild("Teleport-RemoteEvent"):FireServer(unpack(args))
end

-- Function to teleport to a specific zone part
local function teleportToZone(zoneName)
	local char = lp.Character
	if not char then return false end
	
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return false end
	
	local zone = fishZones:FindFirstChild(zoneName)
	if not zone then 
		statusLabel.Text = zoneName .. " not found!"
		return false
	end
	
	local zonePart = zone:IsA("BasePart") and zone or zone:FindFirstChildWhichIsA("BasePart")
	if not zonePart then 
		statusLabel.Text = "No part in " .. zoneName
		return false
	end
	
	statusLabel.Text = "Teleporting to " .. zoneName
	root.CFrame = zonePart.CFrame + Vector3.new(0, 5, 0)
	return true
end

-- Function to get all available target fish (only selected ones)
local function getAvailableFish()
	local available = {}
	for _, fish in ipairs(fishesFolder:GetChildren()) do
		if selectedFishes[fish.Name] and fish:FindFirstChildWhichIsA("BasePart", true) then
			table.insert(available, fish)
		end
	end
	return available
end

-- Function to stick to and collect a fish
local function stickToFish(fish, duration)
	if not fish or not collecting then return end
	
	local char = lp.Character
	if not char then return end
	
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then return end
	
	local part = fish:FindFirstChildWhichIsA("BasePart", true)
	if not part then return end
	
	-- Calculate stick position (no offset for regular fish, +2 for whale)
	local offset = Vector3.new(0, 0, 0)
	
	if fish.Name == "Whale" then
		offset = Vector3.new(0, 2, 0)
		statusLabel.Text = "Sticking to Whale (+2 studs)"
	else
		statusLabel.Text = "Sticking to " .. fish.Name
	end
	
	local startTime = tick()
	local lastPromptTime = 0
	
	while collecting and fish.Parent and tick() - startTime < duration do
		if not fish or not fish.Parent then break end
		
		part = fish:FindFirstChildWhichIsA("BasePart", true)
		if not part then break end
		
		local stickPos = part.Position + offset
		root.CFrame = CFrame.new(stickPos)
		
		if tick() - lastPromptTime > 0.1 then
			for _, obj in ipairs(fish:GetDescendants()) do
				if obj:IsA("ProximityPrompt") then
					fireproximityprompt(obj)
					lastPromptTime = tick()
					break
				end
			end
		end
		
		task.wait(0.1)
	end
end

-- Main collection loop
task.spawn(function()
	while true do
		if collecting then
			-- Check if any fish are selected
			local selectedCount = 0
			for _ in pairs(selectedFishes) do
				selectedCount = selectedCount + 1
			end
			
			if selectedCount == 0 then
				statusLabel.Text = "No fish selected!"
				task.wait(1)
				collecting = false
				collectBtn.Text = "Collect : OFF"
				setSpeed(false)
				teleportToSurface()
			else
				-- STEP 1: Teleport to DeepOcean
				statusLabel.Text = "Phase 1: DeepOcean"
				teleportToZone("DeepOcean")
				task.wait(0.2)
				
				-- STEP 2: Teleport to TheDeepDark
				statusLabel.Text = "Phase 2: TheDeepDark"
				teleportToZone("TheDeepDark")
				task.wait(0.2)
				
				-- STEP 3: Start 50-second collection cycle
				local cycleStart = tick()
				local surfaceReturnTime = cycleStart + collectingTime
				
				statusLabel.Text = "Collecting selected fish..."
				
				while collecting and tick() < surfaceReturnTime do
					local timeLeft = math.max(0, surfaceReturnTime - tick())
					timerLabel.Text = math.ceil(timeLeft) .. "s"
					
					local availableFish = getAvailableFish()
					
					if #availableFish > 0 then
						for _, fish in ipairs(availableFish) do
							if not collecting or tick() >= surfaceReturnTime then break end
							
							local stickDuration = 2.5 + (math.random() * 0.5)
							stickToFish(fish, stickDuration)
							
							if collecting and tick() < surfaceReturnTime then
								task.wait(0.1)
							end
						end
					else
						statusLabel.Text = "No selected fish found"
						task.wait(0.1)
					end
				end
				
				-- Surface phase
				if collecting then
					statusLabel.Text = "Returning to surface..."
					timerLabel.Text = surfaceTime .. "s"
					teleportToSurface()
					
					local surfaceStart = tick()
					while collecting and tick() - surfaceStart < surfaceTime do
						local timeLeft = surfaceTime - (tick() - surfaceStart)
						timerLabel.Text = math.ceil(timeLeft) .. "s"
						task.wait(0.1)
					end
				end
			end
		else
			statusLabel.Text = "Idle"
			timerLabel.Text = "50s"
			task.wait(0.1)
		end
	end
end)

